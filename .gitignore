# ── Lokalno samo — ne ide u repo ────────────────────────────────────
# Reusable kit/templejti za nove projekte. Nije vezan za Door Expert,
# drži se lokalno; u repo idu samo WP fajlovi i projektna dokumentacija.
_NOVI-PROJEKTI/

# Jednokratne setup skripte (blueprint sekcija 10) — nikad u repo, obrisati sa servera posle
_setup/

# ── OS / IDE ────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.idea/

# ── Logovi i privremeni fajlovi ─────────────────────────────────────
*.log
*.tmp

# ── WordPress: tajne i generisani sadrzaj (nikad u repo) ────────────
wp-config.php
/wp-content/uploads/
node_modules/

# Tudji pluginovi (WooCommerce, JetEngine, Rank Math) se instaliraju iz wp-admina
# i azuriraju sami - u repo nemaju sta da traze. Nas sopstveni plugin kod stoji u
# wp-plugins/ na vrhu repoa i odatle se kopira na server.
/wp-content/plugins/
